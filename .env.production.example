# Copy to deploy/.env.production and fill in. Never commit the real file.
DOMAIN=knot.example.com
ACME_EMAIL=ops@example.com

POSTGRES_USER=knot
# Generate with: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=change-me
POSTGRES_DB=knot

SESSION_TTL_DAYS=30
MAX_UPLOAD_MB=5
# Profile videos: upload size (MB) and length (seconds) limits
VIDEO_MAX_MB=50
VIDEO_MAX_SECONDS=30
LOG_LEVEL=info

# Transactional email (required in production for verification and password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mavelle <hello@mavelle.example.com>"

# Mavelle AI — leave as none to run without AI (curated suggestions only)
AI_PROVIDER=none
AI_MODEL=llama3.2:3b
# If using the optional ollama service: http://ollama:11434
OLLAMA_URL=http://ollama:11434
AI_API_URL=
AI_API_KEY=
AI_TIMEOUT_MS=12000
AI_MAX_OUTPUT_CHARS=600
AI_MAX_CONCURRENCY=2
AI_DAILY_USER_LIMIT=20
AI_DAILY_GLOBAL_LIMIT=2000
