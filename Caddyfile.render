# Same single-origin shape as Caddyfile (web + api behind one domain), but for Render:
# Render terminates HTTPS at its edge and forwards plain HTTP to this port, so no `tls`/ACME
# block is needed here (unlike Caddyfile, which fetches its own Let's Encrypt cert).
:10000 {
	encode zstd gzip

	@backend path /api/* /socket.io/* /healthz /readyz
	handle @backend {
		reverse_proxy localhost:4000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
